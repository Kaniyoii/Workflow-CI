name: obesity-ci-project

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      train_path: {type: str, default: "obesity_preprocessing/train.csv"}
      test_path: {type: str, default: "obesity_preprocessing/test.csv"}
      n_estimators: {type: int, default: 200}
      max_depth: {type: str, default: "None"}     # <---
      min_samples_split: {type: int, default: 2}
      min_samples_leaf: {type: int, default: 1}
      n_jobs: {type: int, default: -1}
      random_state: {type: int, default: 42}
    command: >
      python modelling.py
      --train_path {train_path}
      --test_path {test_path}
      --n_estimators {n_estimators}
      --max_depth {max_depth}
      --min_samples_split {min_samples_split}
      --min_samples_leaf {min_samples_leaf}
      --n_jobs {n_jobs}
      --random_state {random_state}
